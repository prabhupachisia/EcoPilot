# Copy to .env and fill in the values for your machine.

PROJECT_NAME=EcoPilot

# EnergyPlus install (needed for anything other than `python main.py --dry-run`)
ENERGYPLUS_HOME=C:\EnergyPlusV26-1-0
ENERGYPLUS_EXE=C:\EnergyPlusV26-1-0\energyplus.exe
# Usually ENERGYPLUS_HOME\Energy+.idd -- override only if yours lives elsewhere.
IDD_PATH=

# Local Ollama instance (needed for anything other than --dry-run)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Closed-loop behavior
MAX_OPTIMIZATION_CYCLES=10
SIMULATION_TIMEOUT=600

# Dashboard
STREAMLIT_PORT=8501

# Logging
LOG_LEVEL=INFO

# Memory / knowledge base storage (relative to the project root)
FAISS_INDEX_PATH=memory/faiss_index
KNOWLEDGE_PATH=knowledge/processed
EXPERIENCE_MEMORY_FILE=experiences.json
CARBON_INTENSITY_PROFILE_PATH=config/carbon_intensity.json
